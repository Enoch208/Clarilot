{
  "name": "@clarilot/scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "verify": "tsx --env-file-if-exists=../.env verify.ts; status=$?; prettier --write ../evidence/verification.json > /dev/null; exit $status"
  },
  "dependencies": {
    "@clarilot/api": "workspace:*",
    "@clarilot/core": "workspace:*",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
