{
  "name": "@clarilot/api",
  "private": true,
  "type": "module",
  "exports": {
    "./env": "./src/env.ts",
    "./db": "./src/db.ts",
    "./files": "./src/files.ts",
    "./registry": "./src/sql/registry.ts",
    "./zetaris": "./src/zetaris/client.ts",
    "./zetaris-env": "./src/zetaris/from-env.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clarilot/core": "workspace:*",
    "@hono/node-server": "2.1.5",
    "hono": "4.13.13",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.23.15"
  }
}
